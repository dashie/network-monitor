# Build output
/target/
**/*.rs.bk
*.pdb

# Tooling
*.log

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Logs and temporary files
# The contents are ignored, not the directory itself, so a .gitkeep placeholder
# inside tmp/ can still be committed (Git cannot re-include a file whose parent
# directory is excluded).
*.log
tmp/*
.tmp/*

# Placeholder files that keep otherwise empty directories in the repository
!.gitkeep
